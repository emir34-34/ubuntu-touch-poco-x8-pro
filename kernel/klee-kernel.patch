+/*
+ * klee dual boot: Ubuntu Touch needs AppArmor, but in recovery mode the
+ * bootloader starts this same kernel (from the boot partition) with the
+ * OrangeFox ramdisk, and Android's init cannot run without SELinux. Only one
+ * of the two can be active, so use SELinux unless the bootloader asked for
+ * a normal boot.
+ */
+static __initconst const char klee_recovery_lsm_order[] =
+	"landlock,lockdown,yama,loadpin,safesetid,integrity,selinux,bpf";
+
+static bool __init klee_recovery_boot(void)
+{
+	const char *v;
+
+	if (strstr(boot_command_line, "androidboot.force_normal_boot=1"))
+		return false;
+	v = xbc_find_value("androidboot.force_normal_boot", NULL);
+	return !(v && !strcmp(v, "1"));
+}
