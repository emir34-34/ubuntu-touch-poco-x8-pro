#!/bin/sh
# klee (MediaTek gen4m Wi-Fi): the chip is switched on by writing "1" to
# /dev/wmtWifi. On Android the vendor Wi-Fi HAL does that; Ubuntu Touch uses
# NetworkManager + wpa_supplicant directly, so do it here.
#
# The write only works after the vendor's wlan_assistant (in the Android
# container) has handed the Wi-Fi NVRAM to the driver and connsys has finished
# its pre-calibration power cycle. Written earlier, the driver logs
# "WMT turn on WIFI fail!" and stays off. wlan0 exists anyway (the netdev is
# persistent), so the old check "does wlan0 exist" passed, and wpa_supplicant
# then got "driver is not ready" forever (boot logs of 2026-10-07).
# UNTESTED on the device.
log() { echo "klee-wifi: $*"; }
seen() { dmesg | grep -c "$1"; }

i=0
while [ ! -e /dev/wmtWifi ] && [ $i -lt 90 ]; do sleep 1; i=$((i + 1)); done
[ -e /dev/wmtWifi ] || { log "/dev/wmtWifi never appeared"; exit 0; }

# 1. NVRAM handed over by wlan_assistant
i=0
while [ "$(seen 'Set NVRAM state\[1\]')" = 0 ] && [ $i -lt 120 ]; do sleep 1; i=$((i + 1)); done
[ $i -lt 120 ] || log "Wi-Fi NVRAM was never loaded (is wlan_assistant running?), trying anyway"

# 2. pre-calibration: the driver is probed once and powered off again
i=0
while [ "$(seen 'Wi-Fi power off done')" = 0 ] && [ $i -lt 30 ]; do sleep 1; i=$((i + 1)); done
sleep 2

for try in 1 2 3 4 5; do
	fails=$(seen 'WMT turn on WIFI fail')
	echo 1 > /dev/wmtWifi 2>/dev/null
	sleep 5
	if [ "$(seen 'WMT turn on WIFI fail')" = "$fails" ] && [ -e /sys/class/net/wlan0 ]; then
		log "Wi-Fi switched on (try $try)"
		exit 0
	fi
	log "switching Wi-Fi on failed (try $try), retrying"
	sleep 5
done
log "could not switch Wi-Fi on"
exit 0
