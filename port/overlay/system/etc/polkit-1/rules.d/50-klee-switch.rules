// klee dual boot: let the phone user start the OS switch / recovery units
// from the "Android'e Geç" and "Recovery'ye Geç" apps without a password.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("verb") == "start" &&
        (action.lookup("unit") == "klee-switch-android.service" ||
         action.lookup("unit") == "klee-reboot-recovery.service") &&
        subject.local && subject.active && subject.user == "phablet") {
        return polkit.Result.YES;
    }
});
